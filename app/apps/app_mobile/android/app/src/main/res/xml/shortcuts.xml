        android:shortcutId="import_recording"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_import_recording_short"
        android:shortcutLongLabel="@string/shortcut_import_recording_long"
        android:shortcutDisabledMessage="@string/shortcut_import_recording_disabled"
        tools:ignore="UnusedAttribute">
