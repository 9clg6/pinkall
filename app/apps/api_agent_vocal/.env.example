# Reference only: Pinkall does not load this file automatically.
HOST=0.0.0.0
PORT=8080
# Optional on Render: RENDER_EXTERNAL_URL is used when this override is absent.
PUBLIC_BASE_URL=https://api.example.com
# Temporary local/POC compatibility. Disable both values after the Flutter
# clients use Supabase user access tokens.
PINKALL_API_TOKEN=replace-with-at-least-24-random-characters
PINKALL_ALLOW_POC_BEARER=true

# SaaS auth foundation (asymmetric Supabase signing keys only). The workspace
# UUID must exist in pinkall_workspaces and remain the only workspace served by
# the snapshot store until sessions are normalized.
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_JWT_AUDIENCE=authenticated
# PINKALL_SNAPSHOT_WORKSPACE_ID=00000000-0000-4000-8000-000000000000

TELNYX_API_KEY=replace-me
TELNYX_API_BASE_URL=https://api.telnyx.com/v2
TELNYX_TELEPHONY_CREDENTIAL_ID=replace-me
TELNYX_PUBLIC_KEY=replace-me
TELNYX_WEBRTC_CONNECTION_ID=replace-me
TELNYX_CALL_CONTROL_CONNECTION_ID=replace-me
TELNYX_FROM_NUMBER=+33100000000
TELNYX_CALLER_NAME=Pinkall
TELNYX_CALLER_NUMBER=+33100000000

# Deepgram Flux handles live turn detection. Set `voxtral` to use the former
# realtime adapter. Voxtral remains required for the final batch transcript.
STT_PROVIDER=deepgram_flux
DEEPGRAM_API_KEY=replace-me
DEEPGRAM_REALTIME_BASE_URL=wss://api.eu.deepgram.com
DEEPGRAM_PRERECORDED_BASE_URL=https://api.eu.deepgram.com
DEEPGRAM_PRERECORDED_MODEL=nova-3
DEEPGRAM_DIARIZE_MODEL=latest
DEEPGRAM_FLUX_MODEL=flux-general-multi
DEEPGRAM_LANGUAGE_HINT=fr
DEEPGRAM_EOT_THRESHOLD=0.85
DEEPGRAM_EAGER_EOT_THRESHOLD=0.6
DEEPGRAM_EOT_TIMEOUT_MS=7000
MISTRAL_API_KEY=replace-me
MISTRAL_REALTIME_BASE_URL=wss://api.mistral.ai
MISTRAL_REALTIME_MODEL=voxtral-mini-transcribe-realtime-2602
MISTRAL_BATCH_BASE_URL=https://api.mistral.ai
MISTRAL_BATCH_MODEL=voxtral-mini-2602
MISTRAL_TARGET_DELAY_MS=1000

OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_COACH_MODEL=gpt-5.4-mini
OPENAI_POST_CALL_MODEL=gpt-5.4-mini
OPENAI_COACH_REASONING_EFFORT=none
OPENAI_POST_CALL_REASONING_EFFORT=low

COACH_MODE_DEFAULT=off
COACH_PROVIDER=openai
POST_CALL_PROVIDER=openai
COACH_RELEASE_CHANNEL=internal_alpha
COACH_CATALOG_DIR=/absolute/path/to/app/knowledge/coaching

# Local, non-durable POC:
PINKALL_ALLOW_EPHEMERAL_STORE=true

# Render/Supabase POC: use the IPv4 Shared Session pooler (:5432), mount the
# Supabase CA, set every value below, then disable the ephemeral store. Keep the
# URL and database password server-side only.
# PINKALL_ALLOW_EPHEMERAL_STORE=false
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
# DATABASE_SSL_ROOT_CERT=/etc/secrets/supabase-ca.crt
# PINKALL_STORAGE_TENANT_ID=pinkall-poc

STRICT_CONFIG=false
